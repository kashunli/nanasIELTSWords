{"batch": 67, "items": [{"stable_id": "bv1at4y1579f-ch21-0108", "part_of_speech": "noun", "meaning_en": "a person made weak or disabled by illness or injury", "meaning_zh": "病人，体弱者", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0109", "part_of_speech": "adjective", "meaning_en": "able to accept delay or annoyance without becoming upset", "meaning_zh": "耐心的", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0110", "part_of_speech": "noun", "meaning_en": "impaired or abnormal functioning of an organ or system", "meaning_zh": "功能障碍", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0111", "part_of_speech": "noun", "meaning_en": "a disease in which the body cannot properly control blood sugar", "meaning_zh": "糖尿病", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0112", "part_of_speech": "noun", "meaning_en": "the condition of being extremely fat in a way that harms health", "meaning_zh": "肥胖症", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0113", "part_of_speech": "adjective", "meaning_en": "above a weight considered normal or healthy", "meaning_zh": "超重的", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0114", "part_of_speech": "noun", "meaning_en": "persistently abnormally high blood pressure", "meaning_zh": "高血压", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0115", "part_of_speech": "verb", "meaning_en": "to cause something to be completely unable to function or move", "meaning_zh": "使瘫痪，使无法运行", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0116", "part_of_speech": "adjective", "meaning_en": "having a sensation of spinning and losing balance", "meaning_zh": "头晕的", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0117", "part_of_speech": "adjective", "meaning_en": "mentally ill or extremely foolish and unreasonable", "meaning_zh": "精神失常的，疯狂的", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0118", "part_of_speech": "noun", "meaning_en": "the habitual inability to get enough sleep", "meaning_zh": "失眠症", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0119", "part_of_speech": "noun", "meaning_en": "an abnormal immune reaction to a normally harmless substance", "meaning_zh": "过敏反应", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0120", "part_of_speech": "noun", "meaning_en": "a sudden severe failure of heart function due to blocked blood flow", "meaning_zh": "心脏病发作", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0121", "part_of_speech": "noun", "meaning_en": "a disease caused by uncontrolled growth of abnormal cells", "meaning_zh": "癌症", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0122", "part_of_speech": "noun", "meaning_en": "inflammation and pain in one or more joints of the body", "meaning_zh": "关节炎", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0123", "part_of_speech": "noun", "meaning_en": "a small inflamed spot on the skin, especially on the face", "meaning_zh": "粉刺，痘痘", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0124", "part_of_speech": "noun", "meaning_en": "a sudden loss of brain function caused by interrupted blood supply", "meaning_zh": "中风", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0125", "part_of_speech": "noun", "meaning_en": "a deadly infectious disease that spreads rapidly through a population", "meaning_zh": "瘟疫", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0126", "part_of_speech": "noun", "meaning_en": "a contagious viral respiratory illness, here referring to avian influenza", "meaning_zh": "流感", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0127", "part_of_speech": "noun", "meaning_en": "a state of intense excitement or enthusiasm about something", "meaning_zh": "狂热，激动", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0128", "part_of_speech": "noun", "meaning_en": "a continuous pain located in the head", "meaning_zh": "头痛", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0129", "part_of_speech": "verb", "meaning_en": "to increase in size, number, or amount", "meaning_zh": "增大，增加", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0130", "part_of_speech": "verb", "meaning_en": "to suppress or hold back a strong emotion", "meaning_zh": "抑制，强忍", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0131", "part_of_speech": "verb", "meaning_en": "to cause physical harm or damage to someone or something", "meaning_zh": "伤害", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0132", "part_of_speech": "noun", "meaning_en": "physical harm or damage to the body", "meaning_zh": "受伤，伤害", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0133", "part_of_speech": "verb", "meaning_en": "to cause emotional pain or damage to someone", "meaning_zh": "伤害，损害", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0134", "part_of_speech": "verb", "meaning_en": "to lose blood or to sacrifice for a cause", "meaning_zh": "流血；牺牲", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0135", "part_of_speech": "verb", "meaning_en": "to injure the skin causing a discolored mark", "meaning_zh": "碰伤，擦伤", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0136", "part_of_speech": "noun", "meaning_en": "a mark left on the skin after a wound has healed", "meaning_zh": "疤痕", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0137", "part_of_speech": "noun", "meaning_en": "an injury to the body or mind", "meaning_zh": "创伤，伤口", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0138", "part_of_speech": "noun", "meaning_en": "a deeply distressing or shocking experience or event", "meaning_zh": "创伤", "meaning_status": "ai_draft"}, {"stable_id": "bv1at4y1579f-ch21-0139", "part_of_speech": "noun", "meaning_en": "a compact mass or swelling